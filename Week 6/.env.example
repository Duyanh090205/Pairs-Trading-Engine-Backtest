# Copy to .env and fill in real values. NEVER commit .env.
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxx
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets

# Discord alerts (optional for Phase 1, required by Phase 4.25)
DISCORD_WEBHOOK_URL=

# State store
STATE_DB_PATH=./live/state/live_state.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=./live/logs

# Strategy (locked — do not change)
ENTRY_Z=3.0
HARD_SL_Z=5.0
BETA_CAP=5.0
USE_COMPOSITE_FILTER=true
